# Server
PORT=8000

# MongoDB — connection string without trailing database name
# The app appends DB_NAME from src/constants.js (default: streamcraft)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net

# CORS — use your frontend origin in production (e.g. http://localhost:5173)
CORS_ORIGIN=*

# JWT — replace secrets with strong random values before deploying
ACCESS_TOKEN_SECRET=your-access-token-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary — from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
