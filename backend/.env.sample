# Server
PORT=8000

# MongoDB — paste your Atlas connection string as-is (query params are fine).
# Do NOT append /streamcraft yourself; the app inserts the DB name safely.
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# CORS — local: http://localhost:5173
# Production: your Vercel URL, e.g. https://your-app.vercel.app
# Multiple: http://localhost:5173,https://your-app.vercel.app
# Temporary open testing: *
CORS_ORIGIN=*

# JWT — replace secrets with strong random values before deploying
ACCESS_TOKEN_SECRET=your-access-token-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary — from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
